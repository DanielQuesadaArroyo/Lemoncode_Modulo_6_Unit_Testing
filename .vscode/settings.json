{
  // Desactivar todas las sugerencias inline
  "editor.inlineSuggest.enabled": false,

  // Desactivar sugerencias rápidas
  "editor.quickSuggestions": {
    "other": "off",
    "comments": "off",
    "strings": "off"
  },

  // Desactivar aceptación de sugerencias
  "editor.acceptSuggestionOnEnter": "off",
  "editor.acceptSuggestionOnCommitCharacter": false,

  // Desactivar triggers de sugerencias
  "editor.suggestOnTriggerCharacters": false,

  // Desactivar sugerencias basadas en palabras
  "editor.wordBasedSuggestions": "off",

  // Desactivar hints de parámetros
  "editor.parameterHints.enabled": false,

  // Desactivar todas las opciones de suggest
  "editor.suggest.showWords": false,
  "editor.suggest.showSnippets": false,
  "editor.suggest.showMethods": false,
  "editor.suggest.showFunctions": false,
  "editor.suggest.showConstructors": false,
  "editor.suggest.showFields": false,
  "editor.suggest.showVariables": false,
  "editor.suggest.showClasses": false,
  "editor.suggest.showStructs": false,
  "editor.suggest.showInterfaces": false,
  "editor.suggest.showModules": false,
  "editor.suggest.showProperties": false,
  "editor.suggest.showEvents": false,
  "editor.suggest.showOperators": false,
  "editor.suggest.showUnits": false,
  "editor.suggest.showValues": false,
  "editor.suggest.showConstants": false,
  "editor.suggest.showEnums": false,
  "editor.suggest.showEnumMembers": false,
  "editor.suggest.showKeywords": false,
  "editor.suggest.showColors": false,
  "editor.suggest.showFiles": false,
  "editor.suggest.showReferences": false,
  "editor.suggest.showCustomcolors": false,
  "editor.suggest.showFolders": false,
  "editor.suggest.showTypeParameters": false,

  // Desactivar tab completion
  "editor.tabCompletion": "off",

  // Desactivar snippets
  "editor.snippetSuggestions": "none",
  "editor.suggest.snippetsPreventQuickSuggestions": false,

  // Desactivar sugerencias de JavaScript
  "javascript.suggest.enabled": false,
  "javascript.suggest.autoImports": false,
  "javascript.suggest.completeFunctionCalls": false,
  "javascript.suggest.names": false,
  "javascript.suggest.paths": false,

  // Desactivar sugerencias de TypeScript
  "typescript.suggest.enabled": false,
  "typescript.suggest.autoImports": false,
  "typescript.suggest.completeFunctionCalls": false,
  "typescript.suggest.names": false,
  "typescript.suggest.paths": false,

  // Desactivar Antigravity completamente
  "antigravity.inlineSuggest.enabled": false,
  "antigravity.enabled": false,

  // Desactivar otras extensiones de autocompletado comunes
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
    "yaml": false,
    "typescript": true,
    "javascript": false,
    "typescriptreact": true,
    "javascriptreact": false
  }
}
